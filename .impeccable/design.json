  "narrative": {
    "overview": "The site preserves the RVAP/RVAS identity: a white reading surface, Deep Navy hero, RVAP Blue actions, and Outfit/Inter typography. Existing logos remain the brand authority. Fonts are self-hosted.",
    "keyCharacteristics": [
      "The homepage uses the RVAP navy-to-blue gradient with a pale-blue architecture preview.",
      "Blue file links and navy descriptions keep the package readable.",
      "Reading-page headers and navigation use light blue surfaces; navy marks the selected page and table headers.",
      "Reserve pale green for successful copying and warm peach for copy failures, always paired with explicit feedback text."
    ],
    "rules": [],
    "dos": [
      "Maintain visible keyboard focus and readable contrast.",
      "Use short color transitions for interaction feedback, with no motion under reduced-motion preferences.",
      "Preserve approval gates and matching before/after topology; never hide content to remove a scrollbar.",
      "Use unchanged Microsoft icons with nearby product names linked to Microsoft Learn."
    ],
    "donts": [
      "Keep the white diagram surfaces unbordered; do not turn the families into rounded cards or add shadows.",
      "Homepage artifact rows link to their setup or handoff section; they do not imply that an architecture file already exists."
    ]
  }
}
