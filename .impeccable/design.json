    {
      "name": "Command Block",
      "kind": "custom",
      "description": "Wrapping navy command block with a destination label, copy control, and reserved feedback space. CSS includes pending, copied, and failure states.",
      "html": "<pre class=\"ds-command\"><span class=\"ds-command-label\">Terminal</span><code>git init\n</code><button class=\"ds-copy-command\" type=\"button\" aria-label=\"Copy terminal command\">Copy</button><span class=\"ds-copy-status\" role=\"status\" aria-atomic=\"true\"></span></pre>",
      "css": ".ds-command{position:relative;max-width:100%;margin:24px 0;padding:64px 22px 22px;border-radius:7px;background:var(--c-heading,#032254);color:#e5efff;white-space:pre-wrap;overflow-wrap:anywhere;font-family:monospace;font-size:13px;line-height:1.7}.ds-command code{font-family:var(--font-mono,\"Cascadia Code\",ui-monospace,monospace);font-size:.84rem}.ds-command-label{position:absolute;top:20px;left:22px;max-width:calc(100% - 142px);color:var(--c-on-dark,#e0ebff);font-family:var(--font-body,\"Inter\",\"Segoe UI\",sans-serif);font-size:.75rem;line-height:1.4;white-space:normal}.ds-copy-command{position:absolute;right:12px;top:10px;min-width:88px;min-height:44px;padding:8px 12px;border:1px solid #8399ba;border-radius:4px;background:#183d70;color:#fff;cursor:pointer;font-family:var(--font-body,\"Inter\",\"Segoe UI\",sans-serif);font-size:.75rem}.ds-copy-command:hover{background:var(--c-action,#0960c1)}.ds-copy-command[data-state=\"copied\"]{background:var(--c-success-bg,#d9f3e7);color:var(--c-success-fg,#16553d);border-color:var(--c-success-bg,#d9f3e7)}.ds-copy-command[data-state=\"error\"]{background:var(--c-error-bg,#ffeadf);color:var(--c-error-fg,#783c23);border-color:var(--c-error-bg,#ffeadf)}.ds-copy-command[aria-disabled=\"true\"]{cursor:wait}.ds-copy-command:focus-visible{outline:3px solid #fff;outline-offset:4px}.ds-copy-status{display:block;min-height:calc(12px + 1.5em);padding-top:12px;color:var(--c-on-dark,#e0ebff);font-family:var(--font-body,\"Inter\",\"Segoe UI\",sans-serif);font-size:.8rem;line-height:1.5;white-space:normal}.ds-command:has(.ds-copy-command[data-state=\"copied\"]) .ds-copy-status{color:var(--c-success-bg,#d9f3e7)}.ds-command:has(.ds-copy-command[data-state=\"error\"]) .ds-copy-status{color:var(--c-error-bg,#ffeadf)}@media(prefers-reduced-motion:no-preference){.ds-copy-command{transition:background-color 140ms ease-out,color 140ms ease-out}}@media(max-width:700px){.ds-copy-status{min-height:calc(12px + 4.5em)}}"
    },
